{
  "AllowedHosts": "*",
  "AppSettings": {
    "JwtAuthority": "https://identity.mygtmotive.com",
    "UseMongoDB": true
  },
  "PathBase": "/",
  "Swagger": {
    "AuthFlow": "AuthorizationCode",
    "EnableTryIt": "Yes"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://mongo:27017",
    "MongoDbDatabaseName": "GtMotiveDB"
  }
}